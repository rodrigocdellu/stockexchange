FROM node:lts-slim AS build
WORKDIR /app
COPY StockExchange.VueUI/package*.json ./
RUN npm ci --ignore-scripts
COPY StockExchange.VueUI/. ./
RUN npm run build

FROM nginx:stable AS final
RUN useradd -r -u 1001 -g nginx nonroot \
    && mkdir -p /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html \
    && chown -R nonroot:nginx /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html
USER nonroot
EXPOSE 80
EXPOSE 443
# 2025/04/21 - Uncomment the line below to replace the default NGINX configuration with your custom one
#COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
